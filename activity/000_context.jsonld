{
    "esgvoc_resolve_modes": {
        "experiments": "reference",
        "references": "full"
    },
    "@context": {
        "@base":"https://esgvoc.ipsl.fr/resource/universe/activity/",
        "@vocab": "http://schema.org/",
        "id": "@id",
        "type":"@type",
        "description":{"@id":"https://schema.org/description"},
        "drs_name": {"@id": "acronym"},
        "experiments":{ 
            "@id": "https://esgvoc.ipsl.fr/resource/universe/experiment/",
            "@type":"@id",
            "@context":{"@base":"https://esgvoc.ipsl.fr/resource/universe/experiment/"}
        },
        "references": {
            "@id": "https://esgvoc.ipsl.fr/resource/universe/reference/",
            "@type": "@id",
            "@context": {
                "@base": "https://esgvoc.ipsl.fr/resource/universe/reference/"
            }
        }
    }
}
